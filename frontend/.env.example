# Backend Base URL (Client-side - for direct API calls and OAuth)
# Use http://localhost:8000 for development
# Use https://your-railway-app.up.railway.app for production
NEXT_PUBLIC_BACKEND_BASE_URL=http://localhost:8000

# WebSocket Configuration (Client-side - for real-time updates)
# Use ws:// for development (ws://localhost:8000)
# Use wss:// for production (wss://your-railway-app.up.railway.app)
NEXT_PUBLIC_WEBSOCKET_BASE_URL=ws://localhost:8000
